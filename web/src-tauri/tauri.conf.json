{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisionHarness",
  "version": "0.1.0",
  "identifier": "com.visionharness.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "VisionHarness",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/visionharness-server"],
    "shortDescription": "Agentic computer vision builder",
    "longDescription": "Design, ground and run computer vision tracking pipelines on video, with a bundled local inference backend."
  }
}
