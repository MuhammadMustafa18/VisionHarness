# Google Gemini API Key
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model (e.g., gemini-2.5-flash, gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# VisionHarness Storage Directories
VISIONHARNESS_WORKFLOWS_DIR=./workflows
VISIONHARNESS_MODELS_CACHE=./models_cache
